{
  "name": "riftvault",
  "version": "0.4.3",
  "description": "RiftVault — A League Skin Collection Viewer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.kadnice.riftvault-skinscout",
    "productName": "RiftVault",
    "files": [
      "**/*",
      "!dist/**",
      "!docs/**",
      "!.github/**",
      "!*.md",
      "!scrape.py",
      "!*.log",
      "!*.vbs",
      "!*.bundle"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "RiftVault",
      "runAfterFinish": true,
      "artifactName": "RiftVault-Setup-${version}.${ext}"
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.1"
  }
}
